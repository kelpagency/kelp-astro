---
import Layout from "../../../Base.astro";
import SimpleHero from "../../../components/SimpleHero.astro";
import AIServices from "../../../components/AIServices.astro";
import { buildCollectionPageSchema, buildItemList } from "../../../lib/schema";
import "../../../styles/pages/_services-list.scss";

const description =
  "AI integrations, chatbots, automation, ecommerce, and search optimization built around your business workflows, connected systems, and human oversight.";
const schema = buildCollectionPageSchema(
  "AI Services",
  description,
  buildItemList([
    { name: "AI Integrations", url: "/services/ai-integrations/" },
    { name: "AI Chatbots & Agents", url: "/services/ai-chatbots-agents/" },
    { name: "AI Automation", url: "/services/ai-automation/" },
    { name: "AI Ecommerce", url: "/services/ai-ecommerce/" },
    {
      name: "AI Search Optimization",
      url: "/services/ai-search-optimization/",
    },
  ]),
);
---

<Layout
  title="AI Services for Business | Kelp Agency"
  description={description}
  schema={schema}
>
  <SimpleHero
    tagline="AI Services"
    title="Practical AI Built Around Your Business"
    description="AI is most useful when it has a clear job, dependable information, and a place in the way your team already works. We help identify that job and connect the experience to the systems behind it."
    lottieFile="kelp-bot-punchy.json"
  />
  <AIServices />
  <section class="service-body">
    <div class="wrapper wrapper--narrow">
      <h2>Start with One Useful Task</h2>
      <p>
        Bring a repeated task, a customer question, or a workflow where
        information is scattered. We can review the data, systems, and decisions
        involved, then recommend a focused first project with clear ownership
        and review points.
      </p>
      <p>
        If discovery is the challenge, start with our free{" "}
        <a href="/website-checker/">Website Checker</a> for a first look at your
        site's AI search readiness.
      </p>
      <p>
        <a href="/contact/" class="button button--green">
          Talk Through Your AI Project
        </a>
      </p>
    </div>
  </section>
</Layout>
