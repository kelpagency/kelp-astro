---
import Layout from '../../Base.astro';
---
<Layout title="Website Review Request Received | Kelp" darkHeader={true} robots="noindex, nofollow">
  <section class="wrapper wrapper--narrow" style="padding-block: 5rem;">
    <h1>Thanks for sharing your website.</h1>
    <p>Kelp has received your review request. To talk through your website with us, book a time that works for you.</p>
    <a class="button button--green" href="/contact/#meetings-embed">Book a meeting ↗</a>
  </section>
</Layout>
