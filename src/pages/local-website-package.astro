---
import Layout from "../Base.astro";
import anewgenLogo from "../assets/anewgen-logo.svg";
import hartsLogo from "../assets/Harts-MM-Logo.svg";
import kelpFounders from "../assets/kelp-09-16-2026-1.jpg";
import m48Logo from "../assets/M48-Logo.png";
import mountaineerLogo from "../assets/Mountaineer_Coffee.png";
import whiteheadLogo from "../assets/Whitehead-Farms-Circle-Badge-DS.png.webp";
import { buildFaqSchema, buildServiceSchema } from "../lib/schema";
import "../styles/pages/local-website-package.scss";

const description = "A focused website package for Florida local businesses that need a clear path from search to call, form, booking, or visit—starting at $2,000.";
const faqs = [
  ["How do I know whether I need a single-page or CMS-based site?", "If you have one focused offer, service, or campaign, a single-page site is usually enough. If you have multiple services, locations, or content that will grow, a CMS gives you room to expand. We’ll confirm the right route in a short fit review."],
  ["Can I update the website myself?", "Yes. When your package includes a CMS, we build reusable editing patterns and show your team how to manage the content you need to change."],
  ["Does Kelp write the content?", "Every package includes content guidance and a clear page structure. Full copywriting can be included when you need finished website copy."],
  ["Will my site work on phones and tablets?", "Yes. Every Kelp website is designed and tested for current desktop, tablet, and mobile screen sizes."],
  ["Is SEO included?", "Foundational on-page SEO is included: page titles, descriptions, heading structure, indexability, performance-conscious development, and analytics. Ongoing SEO can be scoped separately."],
  ["What happens if I need something custom?", "We’ll create a tailored scope for multiple pages, ecommerce, booking, integrations, expanded branding, photography, or other requirements."],
  ["What happens after launch?", "We verify the live website, forms, and tracking. Hosting, maintenance, content, and growth retainers are available when you want ongoing help."],
].map(([question, answer]) => ({ question, answer }));
const included = ["Focused discovery and website brief", "Sitemap or single-page section plan", "Content guidance and structured drafting", "Responsive visual design", "Reusable components and page patterns", "CMS configuration when included", "Forms and conversion paths", "Foundational on-page SEO", "Analytics and conversion tracking", "Accessibility-conscious development", "Quality assurance and launch support", "Post-launch verification"];
const starterIncluded = [
  { title: "Logo + Brand Style Sheet", detail: "custom logo, colors, fonts, on a single sheet guide" },
  { title: "One-Page Website", detail: "a professional website with your business info, services, photos, contact details, and mobile-friendly design" },
  { title: "Brand Photo Session", detail: "1-hour shoot for professional photos to use on your website and social media" },
  { title: "Website Setup + Launch", detail: "we handle getting everything online and ready to use" },
  { title: "3 Months Free Website Hosting", detail: "valued at $100*" },
  { title: "Basic Contact Form", detail: "so customers can easily reach you from the website." },
];
const starterIncludedFormValue = starterIncluded.map(({ title, detail }) => `${title} — ${detail}`).join("; ");
const netlifyFormAttributes: Record<string, string> = { netlify: "" };
const schema = [buildServiceSchema({ name: "Local Business Website Package", description, url: "https://www.kelp.agency/local-website-package/", areaServed: "Florida" }), buildFaqSchema(faqs)];
---
<Layout title="Local Business Website Package | Kelp Creative Agency" description={description} schema={schema} canonicalUrl="/local-website-package/" bodyClass="local-package-page">
  <article class="local-package">
    <section class="lp-hero"><div class="wrapper lp-hero-grid">
      <div data-lg-reveal="fade" data-lg-reveal-stagger=".12"><p class="lp-kicker">Websites for local businesses</p><h1>A <em data-emphasis-color="#42c634" data-emphasis-delay="1000" data-emphasis-duration="900" data-emphasis-iterations="3" data-emphasis-padding="10" data-emphasis-type="circle">great</em> website <span>built by <em data-emphasis-color="#5544f8" data-emphasis-delay="1700" data-emphasis-duration="550" data-emphasis-iterations="4" data-emphasis-variant="secondary">locals.</em></span></h1><p class="lp-lead">A focused website package for local businesses that need a clear, credible path from search to call, form, booking, or visit—without a months-long custom build.</p><div class="lp-actions"><a href="#packages" class="button">View Pricing</a></div><small>Thoughtfully scoped. Carefully built. Launched with confidence.</small></div>
      <div class="lp-art-reveal" data-lg-reveal="layer-to-left" data-lg-reveal-delay=".25"><div class="lp-art"><img
        loading="eager"
        src={kelpFounders.src}
        srcset={`${kelpFounders.src} 1920w`}
        sizes="(max-width: 960px) min(540px, calc(100vw - 2rem)), 40vw"
        width="1920"
        height="2401"
        alt="The Kelp Creative Agency team in downtown Brooksville">
      </div></div>
    </div></section>

    <section class="lp-client-logos" aria-label="Selected clients"><div class="wrapper"><p class="lp-kicker" data-lg-reveal="fade">Trusted by businesses near and far</p><ul data-lg-reveal="fade" data-lg-reveal-stagger=".1">
      <li><img loading="lazy" src={whiteheadLogo.src} srcset={`${whiteheadLogo.src} 600w`} sizes="auto" width="600" height="607" alt="Whitehead Farms"></li>
      <li><img loading="lazy" src={mountaineerLogo.src} srcset={`${mountaineerLogo.src} 1920w`} sizes="auto" width="1920" height="1044" alt="Mountaineer Coffee"></li>
      <li><img loading="lazy" src={m48Logo.src} srcset={`${m48Logo.src} 300w`} sizes="auto" width="300" height="300" alt="Marker 48 Brewing"></li>
      <li><img loading="lazy" src={anewgenLogo.src} srcset={`${anewgenLogo.src} 167w`} sizes="auto" width="167" height="49" alt="A New Generation"></li>
      <li><img loading="lazy" src={hartsLogo.src} srcset={`${hartsLogo.src} 197w`} sizes="auto" width="197" height="138" alt="Hart’s Meat Market"></li>
    </ul></div></section>

    <section class="lp-dark lp-wave lp-problem-section"><div class="wrapper wrapper--narrow lp-split"><div data-lg-reveal="fade" data-lg-reveal-stagger=".12"><p class="lp-kicker lp-red">The problem</p><h2>Your website should make choosing you easy.</h2><p>Many local-business websites make it hard to understand the service, establish trust, or take the next step. Attention slips away before anyone picks up the phone.</p></div><div class="lp-problems" data-lg-reveal="fade" data-lg-reveal-stagger=".12"><p>The offer is unclear.</p><p>The proof is buried.</p><p>The next step is hard to find.</p><strong>Using our website process improves conversions by making it easy to understand, trust, and choose your organization.</strong></div></div></section>

    <section class="lp-pricing lp-wave" id="packages"><div class="wrapper wrapper--narrow"><header class="lp-heading" data-lg-reveal="fade" data-lg-reveal-stagger=".12"><p class="lp-kicker">The packages</p><h2>Simple pricing. <span>No surprises.</span></h2></header><div class="lp-cards" data-lg-reveal="fade" data-lg-reveal-stagger=".15">
      <article class="lp-card"><header><p class="lp-kicker">Kelp Starter</p><h3>$2,000</h3><p>Everything a local business needs to show up, look credible, and get the phone ringing—in one focused bundle.</p></header><ul>{starterIncluded.map(({ title, detail }) => <li><strong>{title}</strong><span>{detail}</span></li>)}</ul></article>
      <article class="lp-card lp-card--secondary"><header><p class="lp-kicker">Need more?</p><h3>Kelp Custom</h3><p>A tailored scope for businesses that need more than the Starter package.</p></header><ul><li>Everything in Kelp Starter, scoped to fit</li><li>Multi-page or CMS-based website</li><li>Expanded brand and content work</li><li>Custom integrations, booking, or ecommerce</li><li>Ongoing support and growth retainer options</li></ul></article>
    </div><div class="lp-pricing-action" data-lg-reveal="fade" data-lg-reveal-stagger=".1"><p>Not sure which fit is right? We’ll help you keep the scope simple.</p><button class="button lp-book-call" type="button">Book a Call</button></div></div></section>

    <section class="lp-dark lp-why"><div class="wrapper lp-split"><div data-lg-reveal="fade" data-lg-reveal-stagger=".12"><p class="lp-kicker">Why Kelp</p><h2>Built simply. Built carefully. Built to last.</h2><p>Kelp is a small senior team of designers, developers, strategists, and content creators. The people you meet are the people doing the work. We focus the scope, explain the decisions, and build a site your business can use with confidence.</p></div><aside class="lp-case-study-reveal" data-lg-reveal="layer-to-left"><a class="lp-case-study" href="/work/mountaineer-coffee/" aria-label="View the Mountaineer Coffee case study"><img
      loading="lazy"
      src="https://i0.wp.com/admin.kelp.agency/wp-content/uploads/2026/01/Mountaineer-Featured-Portrait-3.png?fit=848%2C1026&quality=80&ssl=1"
      srcset="https://i0.wp.com/admin.kelp.agency/wp-content/uploads/2026/01/Mountaineer-Featured-Portrait-3.png?fit=198%2C240&quality=80&ssl=1 198w, https://i0.wp.com/admin.kelp.agency/wp-content/uploads/2026/01/Mountaineer-Featured-Portrait-3.png?fit=661%2C800&quality=80&ssl=1 661w, https://i0.wp.com/admin.kelp.agency/wp-content/uploads/2026/01/Mountaineer-Featured-Portrait-3.png?fit=768%2C929&quality=80&ssl=1 768w, https://i0.wp.com/admin.kelp.agency/wp-content/uploads/2026/01/Mountaineer-Featured-Portrait-3.png?fit=848%2C1026&quality=80&ssl=1 848w"
      sizes="auto"
      width="848"
      height="1026"
      alt="Mountaineer Coffee branding and website case study"><span><small>Local website</small><strong>Mountaineer Coffee</strong><span>View case study →</span></span></a></aside></div></section>

    <section class="lp-process" id="how-it-works"><div class="wrapper wrapper--narrow"><header class="lp-heading" data-lg-reveal="fade" data-lg-reveal-stagger=".12"><p class="lp-kicker">What Kelp handles</p><h2>Everything needed to get from idea to launch.</h2></header><ol data-lg-reveal="fade" data-lg-reveal-stagger=".1"><li><span>01</span><h3>Clarify</h3><p>Define the business goal, audience, offer, and strongest conversion path.</p></li><li><span>02</span><h3>Structure</h3><p>Plan the page, sections, content, proof, and conversion points.</p></li><li><span>03</span><h3>Create</h3><p>Develop the content and visual direction using Kelp’s proven systems.</p></li><li><span>04</span><h3>Build</h3><p>Create the responsive site, forms, analytics, and SEO foundations.</p></li><li><span>05</span><h3>Launch</h3><p>Test, approve, publish, and confirm the important actions work.</p></li></ol></div></section>

    <section class="lp-included" id="included"><div class="wrapper lp-split"><div data-lg-reveal="fade" data-lg-reveal-stagger=".12"><p class="lp-kicker">Our Process</p><h2>A complete path to launch.</h2><p>No mystery boxes. Here’s the work that’s actually included.</p></div><ol data-lg-reveal="fade" data-lg-reveal-stagger=".06">{included.map((item, i) => <li><span>{String(i + 1).padStart(2, "0")}</span>{item}</li>)}</ol></div></section>

    <section class="lp-testimonials"><div class="wrapper"><header class="lp-heading" data-lg-reveal="fade" data-lg-reveal-stagger=".12"><p class="lp-kicker">What local clients say</p><h2>Good work gets talked about.</h2></header><div class="lp-testimonial-grid">
      <div class="lp-testimonial-reveal" data-lg-reveal="layer-to-left"><a class="lp-testimonial-link" href="/work/mountaineer-coffee/" target="_blank" rel="noopener noreferrer" data-testimonial-preview aria-label="View the Mountaineer Coffee case study in a new tab"><blockquote><p>“We love working with Kelp! They always deliver on our vision for our brand, and keep us relevant in the industry. Luke was attentive and persistent during the design process, making time to meet with us in person to make sure we were happy with every detail.”</p><footer><img loading="lazy" src={mountaineerLogo.src} srcset={`${mountaineerLogo.src} 1920w`} sizes="auto" width="1920" height="1044" alt="Mountaineer Coffee"><cite><strong>Daniel and Darby Pritz</strong><span>Owners, Mountaineer Coffee</span></cite></footer></blockquote><video muted loop playsinline preload="metadata" aria-hidden="true"><source src="https://admin.kelp.agency/wp-content/uploads/2026/01/mountaineer-coffee.mp4" type="video/mp4"></video></a></div>
      <div class="lp-testimonial-reveal" data-lg-reveal="layer-to-left" data-lg-reveal-delay=".15"><a class="lp-testimonial-link" href="/work/whitehead-farms-2/" target="_blank" rel="noopener noreferrer" data-testimonial-preview aria-label="View the Whitehead Farms case study in a new tab"><blockquote><p>“The staff at Kelp Creative has been amazing to work with. From logo design to website development, they have gone above and beyond to help create our vision for the event venue we have started.”</p><footer><img loading="lazy" src={whiteheadLogo.src} srcset={`${whiteheadLogo.src} 600w`} sizes="auto" width="600" height="607" alt="Whitehead Farms"><cite><strong>Donnie Whitehead</strong><span>Owner and Operator, Whitehead Farms</span></cite></footer></blockquote><video muted loop playsinline preload="metadata" aria-hidden="true"><source src="https://admin.kelp.agency/wp-content/uploads/2022/01/Whtiehead-Website-Mockup-animation.mp4" type="video/mp4"></video></a></div>
      <div class="lp-testimonial-reveal" data-lg-reveal="layer-to-left" data-lg-reveal-delay=".3"><a class="lp-testimonial-link" href="/work/a-new-generation/" target="_blank" rel="noopener noreferrer" data-testimonial-preview aria-label="View the A New Generation case study in a new tab"><blockquote><p>“Working with Kelp has been an absolute pleasure. Their support, creativity, and professionalism made a meaningful impact on our community, and I sincerely look forward to the opportunity to work together again in the future.”</p><footer><img loading="lazy" src={anewgenLogo.src} srcset={`${anewgenLogo.src} 167w`} sizes="auto" width="167" height="49" alt="A New Generation"><cite><strong>Cheryl Bennett</strong><span>Founder, A New Generation</span></cite></footer></blockquote><video muted loop playsinline preload="metadata" aria-hidden="true"><source src="https://videos.files.wordpress.com/KgtzictB/anewgen-safari_mp4_hd.mp4" type="video/mp4"></video></a></div>
    </div></div></section>
    <section class="lp-faq" id="faq"><div class="wrapper wrapper--narrow lp-faq-grid"><div data-lg-reveal="fade" data-lg-reveal-stagger=".12"><p class="lp-kicker">FAQ</p><h2>Honest answers, <span>plainly put.</span></h2></div><div data-lg-reveal="fade" data-lg-reveal-stagger=".08">{faqs.map((item, i) => <details name="local-package-faq" open={i === 0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>
    <section class="lp-cta lp-wave"><div class="wrapper wrapper--narrow" data-lg-reveal="fade" data-lg-reveal-stagger=".12"><p class="lp-kicker">Find your fit</p><h2>Let’s find the simplest website that will do the job.</h2><p>Tell us about your business, what customers need to do, and what you already have. We’ll recommend the right route.</p><div class="lp-actions"><button class="button button--green lp-book-call" type="button">Book a Call</button></div></div></section>
  </article>

  <dialog class="lp-booking-dialog" id="local-business-booking" aria-labelledby="booking-dialog-title">
    <button class="lp-dialog-close" type="button" aria-label="Close booking form">×</button>
    <div class="lp-booking-step" data-booking-form-step>
      <p class="lp-kicker">Book a call</p>
      <h2 id="booking-dialog-title">Tell us a little about you.</h2>
      <p>Share your details and any additions you have in mind. Then you’ll be able to choose a time for your call.</p>
      <form name="local-business-booking" method="POST" action="/" data-netlify="true" {...netlifyFormAttributes} netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="local-business-booking">
        <input type="hidden" name="package" value="Kelp Starter — starting at $2,000">
        <input type="hidden" name="included" value={starterIncludedFormValue}>
        <p class="lp-honeypot"><label>Don’t fill this out: <input name="bot-field"></label></p>
        <div class="lp-form-grid">
          <label>Name<input type="text" name="name" autocomplete="name" placeholder="Your name" required></label>
          <label>Email<input type="email" name="email" autocomplete="email" placeholder="you@example.com" required></label>
        </div>
        <div class="lp-form-details">
          <div class="lp-included-field">
            <p>What’s included:</p>
            <ul>{starterIncluded.map(({ title }) => <li>{title}</li>)}</ul>
          </div>
          <label>What would you like to add?<textarea name="additions" rows="8" placeholder="Additional pages, ecommerce, booking, content, or anything else..."></textarea></label>
        </div>
        <p class="lp-form-error" role="alert" hidden>We couldn’t submit the form. Please try again.</p>
        <button class="button" type="submit">Continue to Booking</button>
      </form>
    </div>
    <div class="lp-booking-step lp-meetings-step" data-meetings-step hidden>
      <p class="lp-kicker">Choose a time</p>
      <h2>Your details are in. Let’s get your call scheduled.</h2>
      <div class="meetings-iframe-container" data-src="https://store.kelp.agency/meetings/andrew1417?embed=true"></div>
    </div>
  </dialog>
</Layout>

<script>
  const bookingDialog = document.querySelector<HTMLDialogElement>("#local-business-booking");
  const bookingForm = bookingDialog?.querySelector<HTMLFormElement>("form");
  const formStep = bookingDialog?.querySelector<HTMLElement>("[data-booking-form-step]");
  const meetingsStep = bookingDialog?.querySelector<HTMLElement>("[data-meetings-step]");
  const errorMessage = bookingDialog?.querySelector<HTMLElement>(".lp-form-error");
  let bookingScrollPosition = 0;

  document.querySelectorAll<HTMLElement>("[data-testimonial-preview]").forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>("video");
    if (!video) return;
    const playPreview = () => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      void video.play().catch(() => undefined);
    };
    const stopPreview = () => {
      video.pause();
      video.currentTime = 0;
    };
    card.addEventListener("pointerenter", playPreview);
    card.addEventListener("pointerleave", stopPreview);
    card.addEventListener("focusin", playPreview);
    card.addEventListener("focusout", stopPreview);
  });

  const loadMeetingsEmbed = () => {
    if (document.querySelector("script[data-local-meetings-embed]")) return;
    const script = document.createElement("script");
    script.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
    script.async = true;
    script.dataset.localMeetingsEmbed = "true";
    document.body.appendChild(script);
  };

  document.querySelectorAll<HTMLButtonElement>(".lp-book-call").forEach((button) => {
    button.addEventListener("click", () => {
      if (!bookingDialog) return;
      bookingScrollPosition = window.scrollY;
      bookingDialog.showModal();
      bookingDialog.querySelector<HTMLButtonElement>(".lp-dialog-close")?.focus({ preventScroll: true });
      window.scrollTo({ top: bookingScrollPosition, behavior: "instant" });
    });
  });

  bookingDialog?.querySelector<HTMLButtonElement>(".lp-dialog-close")?.addEventListener("click", () => bookingDialog.close());
  bookingDialog?.addEventListener("close", () => window.scrollTo({ top: bookingScrollPosition, behavior: "instant" }));
  bookingDialog?.addEventListener("click", (event) => {
    if (event.target === bookingDialog) bookingDialog.close();
  });

  bookingForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submitButton = bookingForm.querySelector<HTMLButtonElement>("button[type='submit']");
    const body = new URLSearchParams();
    new FormData(bookingForm).forEach((value, key) => body.append(key, String(value)));
    if (submitButton) submitButton.disabled = true;
    if (errorMessage) errorMessage.hidden = true;

    try {
      const response = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: body.toString(),
      });
      if (!response.ok) throw new Error("Form submission failed");
      if (formStep) formStep.hidden = true;
      if (meetingsStep) meetingsStep.hidden = false;
      loadMeetingsEmbed();
    } catch {
      if (errorMessage) errorMessage.hidden = false;
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
