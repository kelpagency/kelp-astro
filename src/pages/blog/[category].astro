---
import BlogArchive from "../../components/BlogArchive.astro";
import { getBlogPosts, getCategoryPosts } from "../../lib/blog";
import { getWpCategories } from "../../lib/wp";

export async function getStaticPaths() {
  const [categories, posts] = await Promise.all([
    getWpCategories(),
    getBlogPosts(),
  ]);
  return categories.map((category) => ({
    params: { category: String(category.slug) },
    props: {
      category: { name: String(category.name), slug: String(category.slug) },
      posts: getCategoryPosts(posts, Number(category.id)),
    },
  }));
}

const { category, posts } = Astro.props;
---

<BlogArchive posts={posts} category={category} />
