---
import design from "../../public/animations/digital-design.json";
import websites from "../../public/animations/web-design.json";
import marketing from "../../public/animations/digital-marketing.json";
import ai from "../../public/animations/kelp-bot-punchy.json";
import media from "../../public/animations/photography.json";
import support from "../../public/animations/ongoing-support.json";
const animations = { design, websites, marketing, ai, media, support };
---
<html><head><title>Menu icon export</title></head><body>
  {Object.entries(animations).map(([name, data]) => (
    <div id={name} data-animation={JSON.stringify(data)} style="width:120px;height:120px;"></div>
  ))}
  <script>
    import lottie from "lottie-web/build/player/lottie_light";
    document.querySelectorAll<HTMLElement>("[data-animation]").forEach((container) => {
      const data = JSON.parse(container.dataset.animation!);
      const animation = lottie.loadAnimation({ container, renderer: "svg", loop: false, autoplay: false, animationData: data });
      animation.addEventListener("DOMLoaded", () => {
        animation.goToAndStop(Math.floor((data.op - data.ip) * 0.45), true);
        container.dataset.ready = "true";
      });
    });
  </script>
</body></html>
