---
import Layout from "../../Base.astro";
import { Picture } from "astro:assets";
import { fetchWpJsonRequired, getWpTags } from "../../lib/wp";
import { buildCollectionPageSchema, buildItemList } from "../../lib/schema";
import { sanitizeTitleHtml, toPlainText } from "../../lib/sanitize";
import { workFilters } from "../../lib/workFilters";

type WorkPost = Record<string, any> & {
  id: number;
  slug: string;
  tags: number[];
  fimg_url?: string;
  title: { rendered: string };
  tagNames?: string[];
  _embedded?: {
    "wp:featuredmedia"?: Array<{
      media_details?: { width?: number; height?: number };
    }>;
  };
};

const posts = await fetchWpJsonRequired(
  "/work?per_page=100&orderby=date&order=desc&_embed=wp:featuredmedia",
  [] as WorkPost[],
);
const tags = (await getWpTags()) as Record<string, any>[];
const filters = workFilters.map((filter) => ({
  ...filter,
  tagIds: tags
    .filter((tag) => (filter.tagSlugs as readonly string[]).includes(tag.slug))
    .map((tag) => tag.id),
}));

const withOrientation: Array<WorkPost & { isLandscape: boolean }> = posts
  .filter((post) => Boolean(post.fimg_url))
  .map((post) => {
    const details = post._embedded?.["wp:featuredmedia"]?.[0]?.media_details;
    return {
      ...post,
      isLandscape: Boolean(
        details?.width && details?.height && details.width > details.height,
      ),
      tagNames: post.tags
        .slice(0, 3)
        .map(
          (id) => tags.find((tag: Record<string, any>) => tag.id === id)?.name,
        )
        .filter(Boolean),
    };
  });
const schema = buildCollectionPageSchema(
  "Our Work",
  "Recent case studies and client work from Kelp Creative Agency.",
  buildItemList(
    withOrientation.slice(0, 24).map((post) => ({
      name: toPlainText(post.title.rendered),
      url: `/work/${post.slug}/`,
    })),
  ),
);
---

<Layout
  title="Branding, Web Design & Marketing Portfolio | Kelp"
  description="See what thoughtful design and strong development look like in practice. Explore Kelp's branding, website, ecommerce, and marketing projects."
  bodyClass="work-archive"
  schema={schema}
>
  <section class="archive">
    <div class="wrapper wrapper--narrow">
      <h1
        style="margin-top: 8rem;"
        data-lg-reveal="fade"
        data-lg-reveal-stagger="0.05"
      >
        <span>Our</span>
        <span>Work</span>
        <span>in</span>
        <span>the</span>
        <span>Real-World</span>
      </h1>
      <p
        style="max-width: 800px; flex: 1 1 500px; font-size: var(--step-1)"
        data-lg-reveal="fade"
        data-lg-reveal-delay=".5"
      >
        The proof is in the pudding as they say here in the south. Weird sayings
        aside, it’s one thing to have a good strategy, but it takes special
        talent to deliver on that strategy in excellence. Take a peak at some of
        our recent work below.
      </p>
    </div>
    <div class="wrapper archive-list">
      <h2 class="screen-reader-text">Case studies</h2>
      <div class="work-filter" data-lg-reveal="fade">
        <label class="work-filter-select">
          <b>Filter by service</b>
          <select class="work-post-filter">
            <option value="">All work</option>
            {filters.map((filter) => (
              <option value={filter.value} data-tags={filter.tagIds.join(",")}>
                {filter.label}
              </option>
            ))}
          </select>
        </label>
      </div>
      {withOrientation.map((post) => (
        <article
          class={`tease ${post.isLandscape ? "tease--wide" : ""}`}
          data-tags={post.tags.join(",")}
        >
          <Picture
            src={post.fimg_url as string}
            alt={toPlainText(post.title.rendered)}
            width={1200}
            height={900}
            widths={[480, 720, 960, 1200, 1600]}
            sizes={
              post.isLandscape
                ? "(max-width: 900px) 100vw, 66vw"
                : "(max-width: 900px) 100vw, 33vw"
            }
            loading="lazy"
            inferSize
          />
          <ul class="tease-tags">
            {post.tagNames?.map((tagName) => (
              <li class="tease-tags-item">{tagName}</li>
            ))}
          </ul>
          <h2 class="h5" transition:name={`heading-${post.id}`}>
            <a
              href={`/work/${post.slug}/`}
              set:html={sanitizeTitleHtml(post.title.rendered)}
            />
          </h2>
        </article>
      ))}
      <p class="work-filter-empty" hidden>
        No work is currently available for this service.
      </p>
    </div>
  </section>
</Layout>

<style lang="scss">
  .archive-list {
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 4rem;
    margin-bottom: 5rem;
    margin-top: 5rem;
    @media (max-width: 900px) {
      display: flex;
      flex-direction: column;
    }
  }
  .work-filter {
    grid-column: 1 / -1;
    width: 100%;
    &-select {
      display: block;
      max-width: 260px;
      b {
        display: block;
        margin-bottom: 0.5rem;
      }
    }
  }
  .work-filter-empty {
    grid-column: 1 / -1;
  }
  .tease {
    position: relative;
    &--wide {
      grid-column: span 2;
    }
    &-tags {
      display: flex;
      gap: 0.5rem;
      list-style: none;
      margin: 1rem 0;
      padding: 0;
      &-item {
        font-size: 0.8rem;
        opacity: 0.7;
      }
    }
    h2 {
      margin: 0;
      a {
        text-decoration: none;
        &::after {
          content: "";
          position: absolute;
          inset: 0;
        }
      }
    }
  }
</style>

<script>
  const initWorkTagFilter = () => {
    const workPostFilter =
      document.querySelector<HTMLSelectElement>(".work-post-filter");
    if (!workPostFilter || workPostFilter.dataset.initialized === "true")
      return;

    workPostFilter.dataset.initialized = "true";
    const posts = Array.from(
      document.querySelectorAll<HTMLElement>(".archive-list .tease"),
    );
    const emptyMessage =
      document.querySelector<HTMLElement>(".work-filter-empty");

    const filterPosts = (selectedTags: string[], hasActiveFilters: boolean) => {
      let visiblePosts = 0;

      posts.forEach((post) => {
        const postTags = (post.dataset.tags ?? "").split(",");
        const isVisible =
          !hasActiveFilters ||
          selectedTags.some((tag) => postTags.includes(tag));
        post.hidden = !isVisible;
        if (isVisible) visiblePosts += 1;
      });

      if (emptyMessage) emptyMessage.hidden = visiblePosts > 0;
      requestAnimationFrame(() => {
        window.luge?.lifecycle?.refresh();
        window.luge?.emitter?.emit("resize");
      });
    };

    const applyFilter = (value: string) => {
      const selectedOption = workPostFilter.selectedOptions[0];
      const selectedTags = (selectedOption?.dataset.tags ?? "")
        .split(",")
        .filter(Boolean);

      const url = new URL(window.location.href);
      if (value) {
        url.searchParams.set("service", value);
      } else {
        url.searchParams.delete("service");
      }
      window.history.replaceState({}, "", url);
      filterPosts(selectedTags, Boolean(value));
    };

    workPostFilter.addEventListener("change", () => {
      applyFilter(workPostFilter.value);
    });

    const selectedService =
      new URL(window.location.href).searchParams.get("service") ?? "";
    const hasSelectedService = Array.from(workPostFilter.options).some(
      (option) => option.value === selectedService,
    );
    workPostFilter.value = hasSelectedService ? selectedService : "";
    applyFilter(workPostFilter.value);
  };

  document.addEventListener("astro:page-load", initWorkTagFilter);
</script>
