---
import Layout from "../../Base.astro";
import FeaturedArticles from "../../components/FeaturedArticles.astro";
import "../../styles/pages/_wordpress.scss";
import sharp from "sharp";
import { Picture } from "astro:assets";
import { sanitizeHtml, toPlainText } from "../../lib/sanitize";
import { toJetpackImageUrl } from "../../lib/jetpack";
import { fetchWpJson, fetchWpJsonRequired } from "../../lib/wp";

export async function getStaticPaths() {
  const posts = await fetchWpJsonRequired(
    "/work?per_page=100&_embed",
    [] as Record<string, any>[],
  );

  return posts.map((post) => {
    return {
      params: { slug: post.slug },
      props: {
        title: post.title.rendered,
        description: toPlainText(post.excerpt.rendered),
        image: [post.fimg_url],
        content: post.content.rendered,
        tagIds: post.tags,
        id: post.id,
        acf: post.acf,
        datePublished: post.date,
        dateModified: post.modified,
      },
    };
  });
}

const {
  title,
  content,
  description,
  image,
  tagIds,
  id,
  acf,
  datePublished,
  dateModified,
} = Astro.props;

const rawTitle = toPlainText(title);
const seoTitle = `${rawTitle} | Kelp`;
const titleWords = rawTitle.split(/\s+/);

const formattedTitle =
  titleWords.length > 1
    ? titleWords
        .map(
          (word: string) =>
            `<span class="work-post-hero-title-word">${word}</span>`,
        )
        .join(" ")
    : rawTitle;

const now = new Date();
const modifiedDate = dateModified ? new Date(dateModified) : null;
const safeDateModified =
  modifiedDate && modifiedDate > now
    ? datePublished
    : dateModified || datePublished;
const cleanDescription = toPlainText(description);
const schema = {
  "@type": "CreativeWork",
  headline: rawTitle,
  description: cleanDescription,
  datePublished,
  dateModified: safeDateModified,
  image: image?.length ? image : undefined,
  publisher: {
    "@id": "https://www.kelp.agency/#organization",
  },
  mainEntityOfPage: {
    "@id": `${Astro.url.href}#webpage`,
  },
};

let bgUrl = null;
let thumbUrl = null;
let bgOriginalUrl = null;

// hero image (ACF hero.background.image)
if (acf?.hero?.background?.image) {
  const media = await fetchWpJson(
    `/media/${acf.hero.background.image}`,
    null as Record<string, any> | null,
  );
  const original = media?.source_url || null;
  bgOriginalUrl = original;
  bgUrl = toJetpackImageUrl(original);
  thumbUrl = toJetpackImageUrl(
    media?.media_details?.sizes?.medium?.source_url ||
      media?.media_details?.sizes?.thumbnail?.source_url ||
      original,
  );
}

let isDarkHero = false;

// brightness detection
if (thumbUrl) {
  try {
    const response = await fetch(thumbUrl, {
      signal: AbortSignal.timeout(10_000),
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const [r, g, b] = await sharp(Buffer.from(await response.arrayBuffer()))
      .resize(1, 1, { fit: "fill" })
      .removeAlpha()
      .raw()
      .toBuffer();
    const brightness = 0.2126 * r + 0.7152 * g + 0.0722 * b;
    isDarkHero = brightness < 165;
  } catch (e) {
    console.warn("Brightness detection failed", e);
  }
}

const accentCandidate =
  typeof acf?.site_frame_color === "string" ? acf.site_frame_color.trim() : "";
const accent = /^(?:transparent|#[\da-f]{3,8})$/i.test(accentCandidate)
  ? accentCandidate
  : "transparent";
const safeContent = sanitizeHtml(content);
---

<Layout
  title={seoTitle}
  description={cleanDescription}
  image={image?.[0]}
  darkHeader={true}
  schema={schema}
  ogType="article"
  articlePublished={datePublished}
  articleModified={safeDateModified}
>
  <article class:list={["work-post", { "work-post--lowman": Astro.params.slug === "lowman-law-firm" }]} style={`--accent: ${accent};`}>
    <div class={`work-post-hero ${isDarkHero ? "is-dark" : ""}`}>
      {
        bgUrl && (
          <Picture
            src={bgOriginalUrl || bgUrl}
            alt={rawTitle}
            width="1920"
            height="1080"
            widths={[768, 1200, 1600, 1920]}
            sizes="100vw"
            priority
            class="work-post-hero-img"
            inferSize
          />
        )
      }
      <div class="wrapper">
        <h1 transition:name={`heading-${id}`} set:html={formattedTitle} />
      </div>
    </div>

    <div
      class="wrapper work-post-body"
      data-lg-reveal="fade"
      data-lg-reveal-stagger="0.3"
      set:html={safeContent}
    />
  </article>

  <FeaturedArticles tag={tagIds} heading="Related Articles" />

  <style lang="scss" is:global>
    .work-post--lowman .work-post-body {
      --section-space: clamp(3.5rem, 7vw, 7rem);
      --content-space: clamp(1.5rem, 3vw, 3rem);
      --image-copy-space: clamp(2.5rem, 5vw, 5rem);

      > .wp-block-columns:not(.has-background) {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        gap: clamp(2rem, 6vw, 6rem);
        margin: var(--section-space) 0;
        align-items: start;

        > .wp-block-column:last-child {
          padding-left: 2rem;
          border-left: 2px solid var(--teal);

          h2 {
            font-family: var(--sans-serif);
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin: 0 0 0.75rem;
          }

          p { font-size: 1rem; line-height: 1.8; }
          p + h2 { margin-top: 2rem; }
        }
      }

      > h2.wp-block-heading:not(.h3) {
        max-width: none;
        margin: var(--section-space) 0 var(--content-space);
        padding-top: var(--content-space);
        border-top: 1px solid rgba(15, 23, 34, 0.16);
      }

      .wp-block-spacer { display: none; }
      .wp-block-heading { text-wrap: balance; }
      h2:not(.h3) { max-width: 28ch; line-height: 1.1; margin: 0 0 2rem; }
      h3 { margin: 3rem 0 1.5rem; }
      > h2 + h3 { margin-top: 0; }
      p { line-height: 1.75; }
      > .wp-block-paragraph,
      .wp-block-group__inner-container > .wp-block-paragraph {
        max-width: 85ch;
        margin: 2rem auto;
        &:has(+ .wp-block-image) { margin-bottom: var(--image-copy-space); }
      }
      > .wp-block-image + .wp-block-paragraph,
      .wp-block-group__inner-container > .wp-block-image + .wp-block-paragraph {
        margin-top: var(--image-copy-space);
      }
      > .wp-block-image:first-child { margin-top: 0; }
      .wp-block-image { margin: 1.5rem 0; }
      .wp-block-image img { display: block; width: 100%; height: auto; }

      .wp-block-columns.has-background {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 2rem;
        padding: clamp(2rem, 4vw, 4rem);
        margin: 3rem 0 2rem;
        border-radius: 1rem;
        background: var(--black) !important;
        color: white;

        .wp-block-column { min-width: 0; }
        h1 { font-family: var(--sans-serif); font-size: clamp(2.5rem, 5vw, 5rem); line-height: 1; color: var(--teal); margin: 0 0 1rem; }
        p { font-size: 0.95rem; line-height: 1.5; margin: 0; }
      }

      .wp-block-group.is-layout-flex {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
        margin: 1.5rem 0;
        padding: 0;
        border: 0;
        > * { min-width: 0; margin: 0; }
      }
      .wp-block-embed { margin: 1.5rem 0; }
      .wp-block-embed__wrapper { aspect-ratio: 16 / 9; overflow: hidden; border-radius: 0.5rem; background: var(--black); }
      .wp-block-embed iframe { display: block; width: 100%; height: 100%; }
      .wp-block-audio { padding: 1.5rem; background: #f4f4f4; border-radius: 0.75rem; }
      audio { display: block; width: 100%; }
      .wp-block-media-text { margin: 3rem 0; background: #f4f4f4; }
      .wp-block-media-text__media { padding: 0; }
      .wp-block-media-text__content { padding: clamp(1.5rem, 4vw, 4rem); }
      .wp-block-media-text__content > :first-child { margin-top: 0; }
      .wp-block-media-text__content > :last-child { margin-bottom: 0; }

      @media (max-width: 767px) {
        > .wp-block-columns:not(.has-background) {
          grid-template-columns: 1fr;
          margin: 3rem 0;
          > .wp-block-column:last-child {
            padding: 1.5rem 0 0;
            border-left: 0;
            border-top: 2px solid var(--teal);
          }
        }
        .wp-block-columns.has-background {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          padding: 2rem 1.25rem;
          gap: 2rem 1rem;
        }
        .wp-block-group.is-layout-flex { grid-template-columns: 1fr; }
      }
    }

    .work-post {
      margin-bottom: 6rem;

      &-hero {
        position: relative;
        padding: 0;
        margin-bottom: -8rem;

        &-img {
          display: block;
          width: 100%;
          height: 100%;
          position: absolute;
          inset: 0;
          img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top center;
          }
        }

        .wrapper {
          padding: 8rem 0 16rem;
          position: relative;
        }

        h1 {
          margin: 0 4rem;
          font-size: var(--step-8);
          line-height: 0.833;

          @media (max-width: 767px) {
            margin: 0;
          }

          span:last-child {
            display: block;
          }

          &::after {
            content: "";
            display: block;
            width: 200px;
            background: var(--accent);
            height: 0.5rem;
            margin-top: 0;
          }
        }
      }

      &-hero.is-dark {
        background-color: var(--black);

        h1 {
          color: #fff;
          text-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
        }
      }

      &-body {
        > .wp-block-image + .wp-block-paragraph {
          margin-top: 5rem;
        }

        > .wp-block-paragraph {
          max-width: 85ch;
          margin-inline: auto;

          &:has(+ .wp-block-image) {
            margin-bottom: 5rem;
          }
        }

        h2 {
          font-size: var(--step-3);
        }

        h3,
        .h3 {
          font-size: var(--step-2);
        }

        blockquote {
          background: #f4f4f4;

          @media (min-width: 961px) {
            padding: 12rem 8rem 11rem;
          }

          @media (max-width: 767px) {
            padding: 2rem;
          }

          p {
            @media (max-width: 767px) {
              font-size: 18px;
            }
          }

          cite {
            display: block;

            @media (max-width: 767px) {
              font-size: 16px;
            }

            &::before {
              margin-top: 2.5rem;
              margin-bottom: 2.5rem;

              @media (max-width: 767px) {
                margin-top: 1.5rem;
                margin-bottom: 1.5rem;
              }
            }
          }

          &::before,
          &::after {
            color: var(--green);
          }

          &::after {
            @media (max-width: 767px) {
              display: none;
            }
          }
        }
      }

      .tiled-gallery {
        &__col {
          @media (max-width: 767px) {
            flex: 1 1 100%;
          }
        }

        &__row {
          display: flex;
          margin: 4rem 0;
          gap: 2rem;

          @media (max-width: 767px) {
            flex-wrap: wrap;
          }

          figure {
            margin: 0;
          }
        }
      }

      .wp-block-media-text__media {
        padding: 1.5rem 1.5rem 0.5rem 1.5rem;

        @media (min-width: 768px) {
          padding: 4rem;
        }
      }

      .wp-element-caption {
        text-align: center;
      }

      .has-white-color {
        color: white;
      }

      .has-black-background-color {
        background: var(--black);
      }

      .footer {
        margin-top: 10rem;
      }
    }
  </style>

  <script>
    const updateEmbeddedIframes = () => {
      document
        .querySelectorAll<HTMLIFrameElement>("iframe[width][height]")
        .forEach((el) => {
          const w = parseFloat(el.getAttribute("width") ?? "0");
          const h = parseFloat(el.getAttribute("height") ?? "0");

          if (w > 0 && h > 0) {
            el.style.aspectRatio = `${w} / ${h}`;
            el.style.width = "100%";
            el.style.height = "auto";
          }
        });
    };

    document.addEventListener("astro:page-load", updateEmbeddedIframes);
  </script>
</Layout>
