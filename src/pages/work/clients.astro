      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("real-estate-construction") ? <a href="/work/?industry=real-estate-construction">Real Estate / Construction</a> : <>Real Estate / Construction</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>Deals In Dirt</li>
        <li>Bluestone Construction</li>
        <li>Buckner Realty</li>
        <li>G2D Architecture</li>
        <li>Runion Custom Homes</li>
        <li>Anclote Restoration</li>
      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("retail") ? <a href="/work/?industry=retail">Retail</a> : <>Retail</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>Beverlin Hills Quality Goods</li>
        <li>Mountaineer Coffee</li>
        <li>Herbert Sherbert</li>
        <li>Skipper McRae Charters</li>
        <li>Westover's Flowers</li>
      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("security") ? <a href="/work/?industry=security">Security</a> : <>Security</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>CDS Security</li>
        <li>Chas D West</li>
        <li>Surelight</li>
      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("software-technology") ? <a href="/work/?industry=software-technology">Software / Technology</a> : <>Software / Technology</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>Appointedd</li>
        <li>Artisan Talent</li>
        <li>Reputation X</li>
        <li>Computers Unlimited</li>
        <li>Modern Campus</li>
      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("venues-attractions") ? <a href="/work/?industry=venues-attractions">Venues &amp; Attractions</a> : <>Venues &amp; Attractions</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>Elev8 Fun</li>
        <li>Whitehead Farms</li>
        <li>Smoky Cove Lodge</li>
        <li>Garden Gate Estate</li>
        <li>Triple C Ranch</li>
        <li>Saxon Events</li>
      </ul>
    </div>
  </div>
</Layout>

<style lang="scss">
  .clients {
    margin-top: 12rem;
    margin-bottom: 5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3rem;
    &-group {
      flex: 1 1 300px;
    }
  }
</style>
