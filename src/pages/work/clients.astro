---
import Layout from '../../Base.astro';
import SimpleHero from '../../components/SimpleHero.astro';
import clientsFront from '../../assets/squid-trident.png';
import clientsBack from '../../assets/images/clients/back.png';
import { buildCollectionPageSchema, buildItemList } from '../../lib/schema';

import { fetchWpJsonRequired, getWpTags } from '../../lib/wp';
import { getWorkIndustries } from '../../lib/workIndustries';

const [workPosts, tags] = await Promise.all([
  fetchWpJsonRequired('/work?per_page=100&_fields=tags,fimg_url', [] as Array<{ tags: number[]; fimg_url?: string }>),
  getWpTags(),
]);
const linkedIndustries = new Set(getWorkIndustries(
  tags as Array<{ id: number; slug: string; name: string }>, workPosts,
).map((industry) => industry.value));

const schema = buildCollectionPageSchema(
  'Kelp Client List',
  'A sample of organizations Kelp Creative Agency has worked with across multiple industries.',
  buildItemList([
    { name: 'Spring Water Spirits', url: '/work/spring-water-spirits/' },
    { name: 'Deals In Dirt', url: '/work/deals-in-dirt/' },
    { name: 'Hart’s Meat Market', url: '/work/harts-meat-market/' },
    { name: 'Elev8 Fun', url: '/work/elev8-fun/' },
    { name: 'Croom Brewery', url: '/work/croom-brewery/' },
    { name: 'Beverlin Hills Quality Goods', url: '/work/beverlin-hills-quality-goods/' },
    { name: 'Murray Family Foundation', url: '/work/murray-family-foundation/' },
    { name: 'US Labels', url: '/work/' },
    { name: 'Agent IQ', url: '/work/' },
    { name: 'Capital Tacos', url: '/work/' },
    { name: 'ReliAscent', url: '/work/' },
    { name: 'Martin Supply', url: '/work/' },
    { name: 'ES Tech Group', url: '/work/' },
    { name: 'Odd Life Studios', url: '/work/' },
    { name: 'Suncoast Obstetrics & Gynecology', url: '/work/' },
    { name: 'Seven Rivers Church', url: '/work/' },
    { name: 'Bluestone Construction', url: '/work/' },
    { name: 'Mountaineer Coffee', url: '/work/' },
    { name: 'CDS Security', url: '/work/' },
    { name: 'Appointedd', url: '/work/' },
    { name: 'Whitehead Farms', url: '/work/' },
  ]),
);
---

<Layout title="Kelp Client List" description="From local shops to national brands, see who Kelp has helped with design, development, and marketing. Explore our clients across a wide range of industries." schema={schema}>
  <SimpleHero
    title="A Sample of Who We've Helped"
    description="From local businesses to national brands, we help organizations across industries bring their ideas to life through thoughtful design, development, and marketing. Here are a few of the teams we've had the pleasure of working with."
    mediaFront={clientsFront}
    mediaFrontWidth={320}
    mediaFrontHeight={480}
    mediaBack={clientsBack}
    mediaBackWidth={506}
    mediaBackHeight={407}
  />
  <div class="clients wrapper wrapper--narrow">
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("ecommerce") ? <a href="/work/?industry=ecommerce">Ecommerce</a> : <>Ecommerce</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>US Labels</li>
        <li>Tilt Audio</li>
        <li>Deco TV</li>
        <li>Revs Institute</li>
      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("financial") ? <a href="/work/?industry=financial">Financial</a> : <>Financial</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>Agent IQ</li>
        <li>Chargeback Gurus</li>
      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("food-beverage-health") ? <a href="/work/?industry=food-beverage-health">Food, Beverage &amp; Health</a> : <>Food, Beverage &amp; Health</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>Spring Water Spirits</li>
        <li>Hart’s Meat Market</li>
        <li>Croom Brewery</li>
        <li>Capital Tacos</li>
        <li>Fitlife Foods</li>
        <li>HS&R Sales</li>
        <li>Marker 48</li>
        <li>Summerland Wine</li>
        <li>Stillpoint Aromatics</li>
      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("government") ? <a href="/work/?industry=government">Government</a> : <>Government</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>ReliAscent</li>
        <li>Technology Applications, Inc.</li>
      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("home-services") ? <a href="/work/?industry=home-services">Home Services</a> : <>Home Services</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>Miller Tree Care</li>
        <li>JD Oates Drywall</li>
        <li>Paff Landscape</li>
      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("industrial-safety") ? <a href="/work/?industry=industrial-safety">Industrial / Safety</a> : <>Industrial / Safety</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>Martin Supply</li>
        <li>Radians, Inc.</li>
        <li>RMI</li>
        <li>Wiseway Supply</li>
        <li>Quad City Safety</li>
      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("marketing-agencies") ? <a href="/work/?industry=marketing-agencies">Marketing Agencies</a> : <>Marketing Agencies</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>ES Tech Group</li>
        <li>Nott Shots</li>
        <li>Big Sea</li>
      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("media") ? <a href="/work/?industry=media">Media</a> : <>Media</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>Odd Life Studios</li>
        <li>Root & Branch Films</li>
        <li>NatureCoaster.com</li>
      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("medical") ? <a href="/work/?industry=medical">Medical</a> : <>Medical</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>Suncoast Obstetrics & Gynecology</li>
        <li>Citrus Gynecology</li>
        <li>Florida Spine and Injury Center</li>
      </ul>
    </div>
    <div class="clients-group">
      <h2 class="h5">{linkedIndustries.has("non-profit") ? <a href="/work/?industry=non-profit">Non-profit</a> : <>Non-profit</>}</h2>
      <ul data-lg-reveal="fade" data-lg-reveal-stagger="0.15">
        <li>Murray Family Foundation</li>
        <li>Seven Rivers Church</li>
        <li>Grace World Outreach Church</li>
        <li>Gateway Bible Church</li>
        <li>Church in the Son</li>
