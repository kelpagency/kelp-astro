---
import { Picture } from "astro:assets";
import BlogPostMeta from "./BlogPostMeta.astro";
import { getWpCategories } from "../lib/wp";
import { isVisibleBlogCategory } from "../lib/blog";
import { sanitizeHtml, sanitizeTitleHtml, toPlainText } from "../lib/sanitize";

export interface Props {
  post: {
    id: number;
    slug: string;
    date: string;
    fimg_url: string;
    categories?: number[];
    title: { rendered: string };
    content: { rendered: string };
    excerpt: { rendered: string };
  };
}
export type BlogTeasePost = Props["post"];

const { post } = Astro.props as Props;
const categories = (await getWpCategories()) as Record<string, any>[];
const categoryName = post.categories
  ?.map((id) => categories.find((cat) => cat.id === id))
  .find((cat) => cat && isVisibleBlogCategory(cat))?.name;
---

<article class="archive-tease">
  <a
    data-astro-prefetch
    href={`/blog/${post.slug}/`}
    class="media"
    transition:name={`hero-${post.id}`}
  >
    <Picture
      src={post.fimg_url}
      alt={toPlainText(post.title.rendered)}
      width={1200}
      height={660}
      widths={[480, 720, 960, 1200]}
      sizes="(max-width: 890px) 100vw, (max-width: 1300px) 50vw, 33vw"
      loading="lazy"
      inferSize
    />
  </a>
  <div class="text">
    <BlogPostMeta
      date={post.date}
      content={post.content.rendered}
      categoryName={categoryName}
    />
    <h2 class="h5" transition:name={`heading-${post.id}`}>
      <a
        href={`/blog/${post.slug}/`}
        set:html={sanitizeTitleHtml(post.title.rendered)}
      />
    </h2>
    <div set:html={sanitizeHtml(post.excerpt.rendered)} />
  </div>
</article>
