---
import { fetchWpCollectionRequired, fetchWpJson } from "../lib/wp";
import { isVisibleBlogCategory } from "../lib/blog";
import BlogPostMeta from "./BlogPostMeta.astro";
import { sanitizeTitleHtml, toPlainText } from "../lib/sanitize";

const {
  category = null,
  tag = null,
  author = null,
  heading = "Featured Articles",
  limit = 3,
  showAll = false,
} = Astro.props;

const hasTagFilter = Array.isArray(tag)
  ? tag.length > 0
  : tag !== null && tag !== undefined && String(tag).trim().length > 0;
const hasAuthorFilter =
  author !== null && author !== undefined && String(author).trim().length > 0;

// Decide taxonomy (backward compatible)
const taxonomyType = hasTagFilter ? "tags" : "categories";
const taxonomyInput = hasTagFilter ? tag : (category ?? "17");

// Normalize input:
// - "17"
// - 17
// - "17,22,31"
// - [17, 22, 31]
const normalizedIds = Array.isArray(taxonomyInput)
  ? taxonomyInput
  : String(taxonomyInput)
      .split(",")
      .map((id) => id.trim())
      .filter(Boolean);

const taxonomyParam = normalizedIds.join(",");
const candidateLimit = hasTagFilter ? 50 : limit * 2;

const filterParam = hasAuthorFilter
  ? `author=${encodeURIComponent(String(author))}`
  : `${taxonomyType}=${taxonomyParam}`;

const postsPath = `/posts?${filterParam}&_embed`;
const posts = showAll
  ? await fetchWpCollectionRequired<Record<string, any>>(postsPath)
  : await fetchWpJson(
      `${postsPath}&per_page=${candidateLimit}`,
      [] as Record<string, any>[],
    );
const requestedTagIds = new Set(normalizedIds.map(String));
const rankedPosts = hasTagFilter
  ? posts.toSorted((a, b) => {
      const getSharedTagCount = (post: Record<string, any>) =>
        (post.tags ?? []).filter((tagId: number | string) =>
          requestedTagIds.has(String(tagId)),
        ).length;

      return getSharedTagCount(b) - getSharedTagCount(a);
    })
  : posts;
const displayedPosts = showAll ? rankedPosts : rankedPosts.slice(0, limit);
const getMainCategoryName = (post: Record<string, any>) => {
  const terms = (post._embedded?.["wp:term"]?.[0] ?? []) as Array<
    Record<string, any>
  >;
  return (post.categories ?? [])
    .map((id: number) => terms.find((term) => term.id === id))
    .find(
      (term: Record<string, any> | undefined) =>
        term && isVisibleBlogCategory(term),
    )?.name;
};
const getFeaturedImage = (post: Record<string, any>) => {
  const details = post._embedded?.["wp:featuredmedia"]?.[0]?.media_details;
  const sources = Object.values(details?.sizes ?? {}) as Array<{
    source_url?: string;
    width?: number;
  }>;
  const srcset = sources
    .filter((source) => source.source_url && source.width)
    .map((source) => `${source.source_url} ${source.width}w`)
    .join(", ");

  return {
    width: details?.width ?? 900,
    height: details?.height ?? 600,
    srcset: srcset || `${post.fimg_url} ${details?.width ?? 900}w`,
  };
};
---

{posts.length > 0 && (
  <section class="featured-articles">
    <div class="wrapper">
      <h3>{heading}</h3>

      <div class="grid">
        {displayedPosts.map((post) => (
          <article>
            {post.fimg_url && (
              <img
                loading="lazy"
                src={post.fimg_url}
                srcset={getFeaturedImage(post).srcset}
                sizes="auto"
                width={getFeaturedImage(post).width}
                height={getFeaturedImage(post).height}
                alt={toPlainText(post.title?.rendered ?? "")}
              />
            )}

            <BlogPostMeta
              date={post.date}
              content={post.content?.rendered ?? ""}
              categoryName={getMainCategoryName(post)}
            />

            <h4 class="h5">
              <a
                href={`/blog/${post.slug}/`}
                set:html={sanitizeTitleHtml(post.title.rendered)}
              />
            </h4>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style lang="scss">
  .featured-articles {
    margin: 8rem 0;

    @media (max-width: 767px) {
      margin: 5rem 0 3rem;
    }

    .grid {
      margin-top: 2rem;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;

      @media (max-width: 900px) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      @media (max-width: 600px) {
        grid-template-columns: 1fr;
      }

      article {
        display: flex;
        flex-direction: column;
        position: relative;

        picture,
        img {
          height: 250px !important;
          object-fit: cover;
        }

        a {
          text-decoration: none;

          &:after {
            content: "";
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
          }
        }

        :global(.text-meta) {
          margin-top: 1.5rem;
        }
      }
    }
  }
</style>
