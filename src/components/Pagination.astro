---
import { getBlogPageUrl } from "../lib/blog";

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;
const pages = Array.from(
  { length: totalPages },
  (_, index) => index + 1,
).filter(
  (page) =>
    page === 1 || page === totalPages || Math.abs(page - currentPage) <= 1,
);
---

{totalPages > 1 && (
  <nav class="archive-pagination" aria-label="Blog pagination">
    {currentPage > 1 && (
      <a
        class="button"
        href={getBlogPageUrl(baseUrl, currentPage - 1)}
        rel="prev"
      >
        ← Previous
      </a>
    )}
    <ul>
      {pages.map((page, index) => (
        <>
          {index > 0 && page - pages[index - 1] > 1 && (
            <li aria-hidden="true">…</li>
          )}
          <li>
            {page === currentPage ? (
              <span
                class="button button--green"
                aria-current="page"
                aria-label={`Page ${page}, current page`}
              >
                {page}
              </span>
            ) : (
              <a
                class="button"
                href={getBlogPageUrl(baseUrl, page)}
                aria-label={`Page ${page}`}
              >
                {page}
              </a>
            )}
          </li>
        </>
      ))}
    </ul>
    {currentPage < totalPages && (
      <a
        class="button"
        href={getBlogPageUrl(baseUrl, currentPage + 1)}
        rel="next"
      >
        Next →
      </a>
    )}
  </nav>
)}

<style lang="scss">
  .archive-pagination {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
    ul {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .button {
      font-size: 1.125rem;
      text-align: center;
      min-width: 2.75rem;
    }
    [aria-current="page"] {
      pointer-events: none;
    }
  }
</style>
