---
interface Props {
  name:
    | "sparkles"
    | "shield"
    | "reset"
    | "settings"
    | "chevron"
    | "download"
    | "clipboard"
    | "search";
}
const { name } = Astro.props;
const paths = {
  sparkles: [
    "m12 3 1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2L12 3Z",
    "M5 3v4M3 5h4M19 16v4M17 18h4",
  ],
  shield: ["M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z", "m9 12 2 2 4-4"],
  reset: ["M3 11a9 9 0 1 1 2.5 7", "M3 3v8h8"],
  settings: ["M4 6h16M4 12h16M4 18h16", "M8 3v6M16 9v6M10 15v6"],
  chevron: ["m6 9 6 6 6-6"],
  download: [
    "M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4",
    "M7 10l5 5 5-5M12 15V3",
  ],
  clipboard: [
    "M9 5H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-3",
    "M9 2h6v6H9Z",
  ],
  search: [
    "M4 7V4h3M17 4h3v3M4 17v3h3M20 17v3h-3",
    "M16 11a5 5 0 1 1-10 0 5 5 0 0 1 10 0Z",
    "m15 15 4 4",
  ],
};
---

<svg
  class="qr-maker__icon"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths[name].map((d) => (
    <path d={d} />
  ))}
</svg>
